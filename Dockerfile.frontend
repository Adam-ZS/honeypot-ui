# Development-only image: it runs the Vite dev server with hot reload.
# For production the frontend is built to static assets (`npm run build`) and
# served by a CDN or static host — see DEPLOY.md.
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
